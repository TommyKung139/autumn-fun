# 部署到 Vercel 前，請在 Vercel 專案的 Settings → Environment Variables 設定以下變數
# （本機測試時可複製此檔為 .env 並填入實際值，vercel dev 會自動讀取）

# 同仁進入查詢網站要輸入的通關密碼（請自訂，例如活動名稱+年份）
SITE_PASSWORD=changeme2026

# 梯長／福委進入 /edit.html 資料編輯後台要輸入的密碼（請自訂，需與上面不同）
EDITOR_PASSWORD=changeme2026-editor

# 用於簽署登入 token 的密鑰，請自訂一串隨機字串（例如用 openssl rand -hex 32 產生）
AUTH_SECRET=please-change-this-to-a-random-long-string

# 選用：分車座位表（/charts.html）的快取秒數，預設 300（5 分鐘）。
# 這一頁要讀取整個 employees collection 才能組出座位表，快取可以避免整梯同時
# 開這一頁時把 Firestore 免費額度用完。數字越小越即時、讀取次數越多。
# CHARTS_CACHE_SECONDS=300

# 選用：設定以下三個變數可讓資料改用 Firebase Firestore 儲存，讓 /edit.html 的編輯
# 即時生效（不設定的話網站仍可正常查詢，只是讀取內建的 data/employees.json，
# /edit.html 的變更無法持久化）。三個值取自 Firebase 服務帳戶 JSON 金鑰，
# 詳見 README.md「Firebase 設定」章節。
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
